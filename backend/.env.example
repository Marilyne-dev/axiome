# ================= AXIOME — variables d'environnement =================
# Copier en .env et adapter. NE JAMAIS committer .env.

# --- Application ---
APP_NAME="AXIOME Audit"
ENVIRONMENT=development            # development | production
BASE_URL=http://localhost:8000
DEFAULT_LANG=fr                    # fr | en
DEFAULT_COUNTRY=France
DEFAULT_CURRENCY=EUR
DEFAULT_REFERENTIEL=PCG_FR

# --- Base de données ---
# Dev (SQLite) :
DATABASE_URL=sqlite:///./axiome.db
# Prod (PostgreSQL) — exemple :
# DATABASE_URL=postgresql+psycopg2://axiome:motdepasse@db:5432/axiome

# --- Sécurité (OBLIGATOIRE en prod : générer une clé forte) ---
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-en-production-secret-tres-long-et-aleatoire
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Compte administrateur initial (créé par init_db) ---
ADMIN_EMAIL=admin@axiome.app
ADMIN_PASSWORD=Admin!ChangeMe2026

# --- IA (Anthropic Claude) — jamais en dur dans le code ---
ANTHROPIC_API_KEY=

# --- Couleurs de marque (design) ---
BRAND_PRIMARY=#0B2545
BRAND_SECONDARY=#C9A227

# --- Abonnements et paiements ---
FRONTEND_URL=http://localhost:5173   # URL publique du site React (retours de paiement)
PAYMENT_SANDBOX=true                 # true = « paiement de test » autorisé. DOIT être false en production.
STRIPE_SECRET_KEY=                   # cartes bancaires (EUR) : clé secrète Stripe (sk_test_... puis sk_live_...)
FEDAPAY_SECRET_KEY=                  # Mobile Money (XOF) : clé secrète FedaPay
FEDAPAY_ENV=sandbox                  # sandbox | live
STRIPE_PUBLISHABLE_KEY=              # clé publique Stripe (pk_test_... puis pk_live_...) : champs carte / IBAN sécurisés
# Virement bancaire : coordonnées d'AXIOME affichées sur la page de paiement
VIREMENT_TITULAIRE=
VIREMENT_BANQUE=
VIREMENT_IBAN=
VIREMENT_BIC=
